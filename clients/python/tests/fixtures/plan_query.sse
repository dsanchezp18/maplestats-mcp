data: {"jsonrpc":"2.0","id":5,"result":{"content":[{"text":"{\"question\":\"Unemployment rate in Alberta\",\"topics\":[{\"topic\":\"labour\",\"label\":\"Jobs, unemployment and wages\",\"matched_terms\":[\"unemployment\"],\"steps\":[{\"tool\":\"ab_economic_list_tables\",\"purpose\":\"Alberta dashboard tables, when the question is Alberta\"},{\"tool\":\"ab_economic_get_data\",\"purpose\":\"Alberta dashboard series: table from the step before\"},{\"tool\":\"statcan_indicators_get_indicators\",\"purpose\":\"latest Labour Force Survey headline\"},{\"tool\":\"wds_search_cubes\",\"purpose\":\"LFS tables by province, CMA, industry or age\"},{\"tool\":\"rdaas_search_classifications\",\"purpose\":\"NAICS or NOC codes to name an industry or job\"},{\"tool\":\"jobbank_search_occupations\",\"purpose\":\"Job Bank wages for an occupation: query (job title or NOC code) gives the NOC 2021 code\"},{\"tool\":\"jobbank_get_wages\",\"purpose\":\"low, median and high wage of that NOC code by economic region or province\"}],\"caveats\":[\"LFS monthly estimates are survey based with sampling error; small areas use 3-month averages.\",\"Job Bank wages are ESDC estimates, not a Statistics Canada table. The main source is the Labour Force Survey; where it is too thin ESDC uses Small Area Estimation, Employment Insurance survey data, the Census or administrative data, so the source and reference period differ between cells (read data_source and reference_period on each row). Low and high are in most cases the 10th and 90th percentiles; median is the prevailing wage. Some cells are suppressed for quality or confidentiality, and some regions show the wage of their province or of Canada as an approximation. The LFS sample leaves out the three territories, some remote regions and First Nations reserves. Wages ignore experience, and some occupations are annual, not hourly.\"]}],\"places\":[{\"place\":\"Alberta\",\"kind\":\"province\",\"steps\":[{\"tool\":\"ab_opendata_search_datasets\",\"purpose\":\"Open Alberta Excel and CSV files\"},{\"tool\":\"ckan_search_datasets\",\"purpose\":\"search with portal='ab'\"},{\"tool\":\"ab_economic_list_indicators\",\"purpose\":\"Alberta Economic Dashboard\"},{\"tool\":\"aer_get_well_licences_daily\",\"purpose\":\"Alberta Energy Regulator reports\"}]}],\"fallback_steps\":[],\"out_of_scope\":null,\"guidance\":[\"Run the steps in order within each topic; each result's provenance gives the source URL and date to cite.\",\"Fetch the figures with these tools and report the reference period they return. Do not stop at a table number and answer from a web search or memory: those often hold older or revised values. For the latest figure, ask for the latest periods (latest_n, recent, last_n_observations), not a date range: your sense of today's date may be out of date.\",\"Before combining sources, align geography (province, CMA, city), period (calendar vs fiscal year, month vs quarter) and units, and say where they differ.\",\"Report each figure with its source; do not merge numbers from different sources into one series.\",\"If a step finds nothing, use search_tools with the step's purpose as the query.\",\"check_answer re-reads the StatCan and Bank of Canada figures you will cite, given the question, and returns only the problems.\",\"For a ratio, a ranking of places, compound annual growth or a count of changes (rate moves) across those series, call calc_ratio, calc_rank, calc_cagr or calc_count_changes rather than doing the arithmetic yourself.\"],\"provenance\":{\"source\":\"maplestats-planner\",\"url\":\"docs://catalogue\",\"queried_at\":\"2026-11-09T21:54:50.858280Z\",\"as_of\":null,\"freshness\":null,\"coverage\":null,\"limits\":\"curated topic and place map; not every tool is listed, use search_tools for anything the plan does not cover\",\"cached\":false,\"lang\":\"en\",\"schema_name\":\"planner.QueryPlan\",\"licence\":null,\"commercial_use\":null,\"caveats\":[],\"reproduce\":\"For scripts, call reproduce_code with this tool's name and arguments.\"}}","type":"text"}],"isError":false,"structuredContent":{"question":"Unemployment rate in Alberta","topics":[{"topic":"labour","label":"Jobs, unemployment and wages","matched_terms":["unemployment"],"steps":[{"tool":"ab_economic_list_tables","purpose":"Alberta dashboard tables, when the question is Alberta"},{"tool":"ab_economic_get_data","purpose":"Alberta dashboard series: table from the step before"},{"tool":"statcan_indicators_get_indicators","purpose":"latest Labour Force Survey headline"},{"tool":"wds_search_cubes","purpose":"LFS tables by province, CMA, industry or age"},{"tool":"rdaas_search_classifications","purpose":"NAICS or NOC codes to name an industry or job"},{"tool":"jobbank_search_occupations","purpose":"Job Bank wages for an occupation: query (job title or NOC code) gives the NOC 2021 code"},{"tool":"jobbank_get_wages","purpose":"low, median and high wage of that NOC code by economic region or province"}],"caveats":["LFS monthly estimates are survey based with sampling error; small areas use 3-month averages.","Job Bank wages are ESDC estimates, not a Statistics Canada table. The main source is the Labour Force Survey; where it is too thin ESDC uses Small Area Estimation, Employment Insurance survey data, the Census or administrative data, so the source and reference period differ between cells (read data_source and reference_period on each row). Low and high are in most cases the 10th and 90th percentiles; median is the prevailing wage. Some cells are suppressed for quality or confidentiality, and some regions show the wage of their province or of Canada as an approximation. The LFS sample leaves out the three territories, some remote regions and First Nations reserves. Wages ignore experience, and some occupations are annual, not hourly."]}],"places":[{"place":"Alberta","kind":"province","steps":[{"tool":"ab_opendata_search_datasets","purpose":"Open Alberta Excel and CSV files"},{"tool":"ckan_search_datasets","purpose":"search with portal='ab'"},{"tool":"ab_economic_list_indicators","purpose":"Alberta Economic Dashboard"},{"tool":"aer_get_well_licences_daily","purpose":"Alberta Energy Regulator reports"}]}],"fallback_steps":[],"out_of_scope":null,"guidance":["Run the steps in order within each topic; each result's provenance gives the source URL and date to cite.","Fetch the figures with these tools and report the reference period they return. Do not stop at a table number and answer from a web search or memory: those often hold older or revised values. For the latest figure, ask for the latest periods (latest_n, recent, last_n_observations), not a date range: your sense of today's date may be out of date.","Before combining sources, align geography (province, CMA, city), period (calendar vs fiscal year, month vs quarter) and units, and say where they differ.","Report each figure with its source; do not merge numbers from different sources into one series.","If a step finds nothing, use search_tools with the step's purpose as the query.","check_answer re-reads the StatCan and Bank of Canada figures you will cite, given the question, and returns only the problems.","For a ratio, a ranking of places, compound annual growth or a count of changes (rate moves) across those series, call calc_ratio, calc_rank, calc_cagr or calc_count_changes rather than doing the arithmetic yourself."],"provenance":{"source":"maplestats-planner","url":"docs://catalogue","queried_at":"2026-11-09T21:54:50.858280Z","as_of":null,"freshness":null,"coverage":null,"limits":"curated topic and place map; not every tool is listed, use search_tools for anything the plan does not cover","cached":false,"lang":"en","schema_name":"planner.QueryPlan","licence":null,"commercial_use":null,"caveats":[],"reproduce":"For scripts, call reproduce_code with this tool's name and arguments."}}}}

